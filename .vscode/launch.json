{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug current script via harness",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/harness/run.js",
      "cwd": "${workspaceFolder}",
      "args": ["--script", "${file}"],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Debug preprocessor mode",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/harness/run.js",
      "args": ["--mode", "preprocessor", "--script", "${file}"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Debug webhook mode",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/harness/run.js",
      "args": ["--mode", "webhook", "--script", "${file}"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
